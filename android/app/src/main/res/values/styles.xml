<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Opaque window background prevents parent screen showing through during transitions -->
        <item name="android:windowBackground">@color/app_window_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="BootTheme" parent="Theme.BootSplash">
        <item name="android:statusBarColor">@color/bootsplash_background</item>
        <!-- The splash background is near-white here, so the status bar icons
             have to be dark or the clock and battery vanish for its duration. -->
        <item name="android:windowLightStatusBar">true</item>

        <item name="bootSplashBackground">@color/bootsplash_background</item>
        <!-- Resolves to drawable-night-*/bootsplash_logo.webp (the white logo)
             when the system is in dark mode; see scripts/generate-bootsplash.js. -->
        <item name="bootSplashLogo">@drawable/bootsplash_logo</item>
        <item name="postBootSplashTheme">@style/AppTheme</item>
    </style>
</resources>
